generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String      @id @default(cuid())
  name       String?
  email      String      @unique
  image      String?
  provider   String?
  createdAt  DateTime    @default(now())

  recommends Recommend[]
}

model Recommend {
  id       String @id @default(cuid())
  qiitaId  String
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  @@unique([userId, qiitaId])
}